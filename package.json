{
  "name": "filtermydiscogs",
  "version": "0.0.1",
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev -p 6767 --webpack",
    "build": "pnpm run db:generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 6767",
    "tsc:ci": "tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:check": "biome check --changed --since origin/main --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:all": "pnpm lint:check && pnpm lint:css:fix",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "test": "jest --runInBand --detectOpenHandles",
    "test:ci": "jest --passWithNoTests",
    "test:file": "jest --runInBand --detectOpenHandles --watch --",
    "scaffold": "scripts/scaffold.sh",
    "db:generate": "prisma generate",
    "db:push": "bash scripts/load-env-and-push.sh",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:pull:dev": "bash scripts/pull-db-env.sh development",
    "db:pull:prod": "bash scripts/pull-db-env.sh production",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "analyze": "ANALYZE=true pnpm build",
    "bundle-report": "pnpm build && npx @next/bundle-analyzer",
    "lighthouse": "npx lighthouse http://localhost:6767 --output=html --output-path=./lighthouse-report.html",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "knip:ci": "knip --no-progress"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.9",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "classnames": "^2.5.1",
    "jotai": "^2.20.1",
    "js-cookie": "^3.0.8",
    "next": "16.2.9",
    "oauth-1.0a": "^2.2.6",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-intersection-observer": "^10.0.3",
    "recharts": "^3.9.0",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@faker-js/faker": "10.5.0",
    "@jest/globals": "^30.4.1",
    "@jest/types": "^30.4.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "dotenv-cli": "^11.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fetch-mock": "^3.0.3",
    "knip": "^6.20.0",
    "lighthouse": "^13.4.0",
    "postcss": "^8.5.15",
    "postcss-custom-media": "^12.0.1",
    "prisma": "^7.8.0",
    "react-is": "^19.2.7",
    "stylelint": "^17.13.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
