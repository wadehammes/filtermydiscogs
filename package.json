{
  "name": "filtermydiscogs",
  "version": "0.0.1",
  "packageManager": "pnpm@12.3.4",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "NODE_OPTIONS='--inspect' next dev -p 6767",
    "predev:webpack": "prisma generate",
    "dev:webpack": "NODE_OPTIONS='--inspect' next dev --webpack -p 6767",
    "build": "pnpm run db:generate && bash scripts/migrate-deploy.sh && next build",
    "postinstall": "prisma generate && pnpm generate:theme-init",
    "start": "next start -p 6767",
    "tsc:ci": "pnpm db:generate && tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:check": "biome check --changed --since origin/main --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:all": "pnpm lint:check && pnpm lint:css:fix && pnpm tsc:ci && pnpm knip:ci",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand --detectOpenHandles",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand --passWithNoTests",
    "test:ci:shard": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand --passWithNoTests --shard=${JEST_SHARD:?Set JEST_SHARD e.g. 1/3}",
    "generate:theme-init": "node --experimental-strip-types scripts/generate-theme-init.ts && biome format --write public/theme-init.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ci": "playwright install chromium --with-deps && playwright test",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' jest --coverage --runInBand --detectOpenHandles",
    "test:file": "jest --runInBand --detectOpenHandles --watch --",
    "scaffold": "scripts/scaffold.sh",
    "db:generate": "prisma generate",
    "db:push": "bash scripts/load-env-and-push.sh",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:prod": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:pull:dev": "bash scripts/pull-db-env.sh development",
    "db:pull:staging": "bash scripts/pull-db-env.sh staging",
    "db:pull:prod": "bash scripts/pull-db-env.sh production",
    "db:migrate:staging": "dotenv -e .env.local -- prisma migrate deploy",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "analyze": "ANALYZE=true next build --webpack",
    "bundle-report": "pnpm build && npx @next/bundle-analyzer",
    "lighthouse": "npx lighthouse http://localhost:6767 --output=html --output-path=./lighthouse-report.html",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "knip:ci": "knip --no-progress"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/charts": "^0.16.2",
    "@tanstack/charts-scales": "^0.16.2",
    "@tanstack/react-charts": "^0.16.2",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.11",
    "classnames": "^2.5.1",
    "d3-shape": "^3.2.0",
    "jotai": "^2.20.3",
    "js-cookie": "^3.0.8",
    "next": "16.3.4",
    "oauth-1.0a": "^2.2.6",
    "pg": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-intersection-observer": "^11.0.1",
    "youtube-video-element": "^1.9.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@faker-js/faker": "10.6.0",
    "@jest/globals": "^30.5.1",
    "@jest/types": "^30.5.1",
    "@next/bundle-analyzer": "^16.3.4",
    "@next/playwright": "16.3.4",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-shape": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-fetch-mock": "^4.2.0",
    "jest-location-mock": "^4.0.1",
    "knip": "^6.35.1",
    "lighthouse": "^13.4.1",
    "prisma": "^7.10.0",
    "prisma-json-types-generator": "^5.1.1",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-langservice": "npm:typescript@6.0.3"
  }
}
