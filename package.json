{
  "name": "filtermydiscogs",
  "version": "0.0.1",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev -p 6767",
    "dev:webpack": "NODE_OPTIONS='--inspect' next dev --webpack -p 6767",
    "build": "pnpm run db:generate && bash scripts/migrate-deploy.sh && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 6767",
    "tsc:ci": "pnpm db:generate && tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:check": "biome check --changed --since origin/main --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:all": "pnpm lint:check && pnpm lint:css:fix && pnpm tsc:ci && pnpm knip:ci",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "test": "jest --runInBand --detectOpenHandles",
    "test:ci": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles",
    "test:file": "jest --runInBand --detectOpenHandles --watch --",
    "scaffold": "scripts/scaffold.sh",
    "db:generate": "prisma generate",
    "db:push": "bash scripts/load-env-and-push.sh",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:prod": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:pull:dev": "bash scripts/pull-db-env.sh development",
    "db:pull:staging": "bash scripts/pull-db-env.sh staging",
    "db:pull:prod": "bash scripts/pull-db-env.sh production",
    "db:migrate:staging": "dotenv -e .env.local -- prisma migrate deploy",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "analyze": "ANALYZE=true pnpm build",
    "bundle-report": "pnpm build && npx @next/bundle-analyzer",
    "lighthouse": "npx lighthouse http://localhost:6767 --output=html --output-path=./lighthouse-report.html",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "knip:ci": "knip --no-progress"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/charts": "^0.16.0",
    "@tanstack/charts-scales": "^0.16.0",
    "@tanstack/react-charts": "^0.16.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "classnames": "^2.5.1",
    "d3-shape": "^3.2.0",
    "jotai": "^2.20.3",
    "js-cookie": "^3.0.8",
    "next": "16.3.4",
    "oauth-1.0a": "^2.2.6",
    "pg": "catalog:",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-intersection-observer": "^11.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@faker-js/faker": "10.6.0",
    "@jest/globals": "^30.4.1",
    "@jest/types": "^30.4.1",
    "@next/bundle-analyzer": "^16.3.4",
    "@next/playwright": "16.3.4",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3-shape": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.0",
    "jest-fetch-mock": "^4.2.0",
    "jest-location-mock": "^4.0.1",
    "knip": "^6.34.0",
    "lighthouse": "^13.4.1",
    "prisma": "^7.10.0",
    "prisma-json-types-generator": "^5.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-langservice": "npm:typescript@6.0.3"
  }
}
