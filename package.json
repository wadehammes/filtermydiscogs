{
  "name": "filtermydiscogs",
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev -p 6767 --webpack",
    "build": "pnpm run db:generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 6767",
    "tsc:ci": "tsc --strict",
    "lint": "biome check src",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "test": "jest --runInBand --detectOpenHandles",
    "test:ci": "jest --passWithNoTests",
    "test:file": "jest --runInBand --detectOpenHandles --watch --",
    "scaffold": "scripts/scaffold.sh",
    "db:generate": "prisma generate",
    "db:push": "bash scripts/load-env-and-push.sh",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:pull:dev": "bash scripts/pull-db-env.sh development",
    "db:pull:prod": "bash scripts/pull-db-env.sh production",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "analyze": "ANALYZE=true pnpm build",
    "bundle-report": "pnpm build && npx @next/bundle-analyzer",
    "lighthouse": "npx lighthouse http://localhost:6767 --output=html --output-path=./lighthouse-report.html",
    "type-check": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@faker-js/faker": "10.4.0",
    "@next/third-parties": "^16.2.4",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "classnames": "^2.5.1",
    "html-react-parser": "^6.0.1",
    "isbot": "^5.1.38",
    "js-cookie": "^3.0.5",
    "lodash.flatten": "^4.4.0",
    "next": "16.2.4",
    "oauth-1.0a": "^2.2.6",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-intersection-observer": "^10.0.3",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "usehooks-ts": "^3.1.1"
  },
  "pnpm": {
    "overrides": {
      "@types/pg": "8.20.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@jest/test-sequencer": "30.3.0",
    "@jest/types": "^30.3.0",
    "@next/bundle-analyzer": "^16.2.4",
    "@next/eslint-plugin-next": "^16.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-when": "^3.5.5",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash.flatten": "^4.4.9",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "critters": "^0.0.25",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-location-mock": "^3.0.0",
    "jest-mock": "^30.3.0",
    "jest-transformer-svg": "^2.1.0",
    "jest-when": "^4.0.2",
    "knip": "^6.5.0",
    "lighthouse": "^13.1.0",
    "postcss": "^8.5.10",
    "postcss-custom-media": "^12.0.1",
    "prisma": "^7.7.0",
    "react-is": "^19.2.5",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2"
  }
}
