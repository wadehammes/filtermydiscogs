{
  "$schema": "./node_modules/fallow/schema.json",
  // Ad-hoc codebase intelligence for agents (CI dead-code gate stays on Knip — knip.json).
  "ignoreDependencies": [
    // react-email CLI preview (`pnpm email:dev`); no src/ imports — Knip requires it listed
    "@react-email/ui",
    "@svgr/webpack",
    "identity-obj-proxy",
    "jest-fixed-jsdom",
    "jest-fetch-mock",
    "jest-location-mock",
    "typescript-langservice",
    "tslib"
  ],
  "ignoreDependencyOverrides": [
    { "package": "effect", "source": "pnpm-workspace.yaml" },
    { "package": "svgo", "source": "pnpm-workspace.yaml" },
    { "package": "picomatch", "source": "pnpm-workspace.yaml" },
    { "package": "postcss", "source": "pnpm-workspace.yaml" },
    { "package": "hono", "source": "pnpm-workspace.yaml" },
    { "package": "@hono/node-server", "source": "pnpm-workspace.yaml" },
    {
      "package": "@babel/plugin-transform-modules-systemjs",
      "source": "pnpm-workspace.yaml"
    }
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreExports": [
    { "file": "src/context/auth.context.tsx", "exports": ["*"] },
    { "file": "src/types/index.ts", "exports": ["*"] },
    { "file": "src/context/collection.context.tsx", "exports": ["*"] },
    { "file": "src/types/dashboard.types.ts", "exports": ["*"] },
    { "file": "src/utils/milestones.ts", "exports": ["*"] },
    { "file": "src/utils/styleEvolution.ts", "exports": ["*"] },
    { "file": "src/hooks/useCollectionCacheReady.hook.ts", "exports": ["*"] },
    { "file": "src/utils/collectionCacheSync.ts", "exports": ["*"] }
  ],
  // CI: scripts/fallow-audit-ci.sh (pnpm fallow:audit:ci) — advisory (always exit 0); worsened complexity + introduced architecture.
  // Local pr-prep: pnpm fallow:audit (gate: new-only).
  "audit": {
    "gate": "new-only",
    "worsened": "warn"
  },
  // rulePacks: [".fallow/filtermydiscogs-policy.jsonc"] + policy-violation warn — after file is on staging (audit base tree).
  "rules": {
    "duplicate-export": "warn",
    "boundary-violation": "warn"
  },
  "boundaries": {
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "e2e/**",
        "prisma/**",
        "scripts/**",
        ".jest/**",
        "src/tests/**",
        "src/analytics/**",
        "src/@types/**",
        "cssprops.d.ts",
        "jest.config.ts",
        "next.config.ts",
        "playwright.config.ts",
        "prisma.config.ts",
        "stylelint.config.mjs",
        "sentry.edge.config.ts",
        "sentry.server.config.ts",
        "src/instrumentation.ts",
        "src/instrumentation-client.ts",
        "src/proxy.ts",
        "public/mockServiceWorker.js",
        "public/e2e/**"
      ]
    },
    "zones": [
      { "name": "types", "patterns": ["src/types/**"] },
      {
        "name": "constants",
        "patterns": ["src/constants/**", "src/constants.ts"]
      },
      { "name": "styles", "patterns": ["src/styles/**"] },
      { "name": "utils", "patterns": ["src/utils/**"] },
      { "name": "lib", "patterns": ["src/lib/**", "src/services/**"] },
      { "name": "api", "patterns": ["src/api/**"] },
      { "name": "atoms", "patterns": ["src/atoms/**"] },
      { "name": "context", "patterns": ["src/context/**"] },
      { "name": "hooks", "patterns": ["src/hooks/**"] },
      { "name": "components", "patterns": ["src/components/**"] },
      { "name": "app", "patterns": ["src/app/**"] }
    ],
    "rules": [
      { "from": "types", "allow": ["types", "constants", "utils"] },
      { "from": "constants", "allow": ["types", "constants", "components"] },
      { "from": "styles", "allow": ["types", "constants", "styles", "utils"] },
      {
        "from": "lib",
        "allow": ["types", "constants", "utils", "lib", "api", "hooks"]
      },
      { "from": "api", "allow": ["types", "constants", "utils", "lib", "api"] },
      {
        "from": "atoms",
        "allow": ["types", "constants", "utils", "lib", "atoms"]
      },
      {
        "from": "context",
        "allow": [
          "types",
          "constants",
          "utils",
          "lib",
          "api",
          "atoms",
          "hooks",
          "context",
          "components"
        ]
      },
      {
        "from": "hooks",
        "allow": [
          "types",
          "constants",
          "utils",
          "lib",
          "api",
          "atoms",
          "hooks",
          "context",
          "components"
        ]
      },
      {
        "from": "utils",
        "allow": [
          "types",
          "constants",
          "styles",
          "utils",
          "lib",
          "api",
          "atoms",
          "hooks",
          "context",
          "components"
        ]
      },
      {
        "from": "components",
        "allow": [
          "types",
          "constants",
          "styles",
          "utils",
          "lib",
          "api",
          "atoms",
          "hooks",
          "context",
          "components"
        ]
      },
      {
        "from": "app",
        "allow": [
          "types",
          "constants",
          "styles",
          "utils",
          "lib",
          "api",
          "atoms",
          "hooks",
          "context",
          "components",
          "app"
        ]
      }
    ],
    "calls": {
      "forbidden": [
        {
          "from": "components",
          "callee": [
            "alert",
            "confirm",
            "prompt",
            "child_process.*",
            "fs.*",
            "node:fs.*"
          ]
        },
        {
          "from": "hooks",
          "callee": [
            "alert",
            "confirm",
            "prompt",
            "child_process.*",
            "fs.*",
            "node:fs.*"
          ]
        },
        {
          "from": "atoms",
          "callee": [
            "alert",
            "confirm",
            "prompt",
            "child_process.*",
            "fs.*",
            "node:fs.*"
          ]
        },
        {
          "from": "context",
          "callee": [
            "alert",
            "confirm",
            "prompt",
            "child_process.*",
            "fs.*",
            "node:fs.*"
          ]
        },
        {
          "from": "utils",
          "callee": [
            "alert",
            "confirm",
            "prompt",
            "child_process.*",
            "fs.*",
            "node:fs.*"
          ]
        },
        {
          "from": "api",
          "callee": [
            "alert",
            "confirm",
            "prompt",
            "child_process.*",
            "fs.*",
            "node:fs.*"
          ]
        },
        {
          "from": "app",
          "callee": ["alert", "confirm", "prompt"]
        }
      ]
    }
  },
  "ignorePatterns": ["public/theme-init.js", ".jest/**"],
  "health": {
    // Score and complexity focus on shipped code; specs/page objects stay reachable via the graph.
    "ignore": ["**/*.spec.ts", "**/*.spec.tsx", "**/*.po.tsx", "e2e/**"],
    // After `pnpm test:coverage`, Fallow uses Istanbul for per-function CRAP (optional locally).
    "coverage": "coverage/coverage-final.json"
  },
  "entry": [
    ".jest/setupTests.ts",
    ".jest/setEnvVars.ts",
    "src/tests/mocks/mockCanvas.mock.ts",
    "src/tests/mocks/mockNextRouter.mock.ts",
    "src/lib/__mocks__/api-helpers.ts",
    "src/styles/stylelint-custom-properties.css",
    "src/styles/modules/base-ui-tooltip.module.css",
    "src/styles/modules/action-icon-hover.module.css",
    "src/styles/modules/action-indicator-dot.module.css",
    "src/styles/modules/badge.module.css",
    "src/styles/modules/bottom-drawer-chrome.module.css",
    "src/styles/modules/chevron-expand.module.css",
    "src/styles/modules/dashboard-chart.module.css",
    "src/styles/modules/dashboard-stack.module.css",
    "src/styles/modules/field-label.module.css",
    "src/styles/modules/inline-popover-menu.module.css",
    "src/styles/modules/menu-item-interaction.module.css",
    "src/styles/modules/modal-dialog.module.css",
    "src/styles/modules/patterns.module.css",
    "src/styles/modules/portal-enter-exit.module.css",
    "src/styles/modules/scratchpad-textarea.module.css",
    "src/styles/modules/workspace-fab-chrome.module.css"
  ],
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "boundary-violation": "off"
      }
    },
    {
      "files": ["src/types/**"],
      "rules": {
        "unused-export": "off",
        "unused-type": "off"
      }
    },
    {
      "files": ["src/context/**"],
      "rules": {
        "unused-export": "off",
        "unused-type": "off",
        "unused-enum-member": "off"
      }
    },
    {
      "files": ["src/tests/factories/BaseFactory.ts"],
      "rules": {
        "unused-class-member": "off"
      }
    },
    {
      "files": [
        "src/components/ReleaseNotes/ReleaseNotesEditor.context.tsx",
        "src/atoms/view.atoms.ts",
        "src/components/FormDialog/**",
        "src/components/InlinePopoverMenu/**",
        "src/components/SegmentedControl/**"
      ],
      "rules": {
        "unused-export": "off",
        "unused-type": "off"
      }
    },
    {
      "files": [
        "src/hooks/queries/useAdminStatsQuery.ts",
        "src/hooks/usePersistUserPreferences.hook.ts"
      ],
      "rules": {
        "unused-type": "off"
      }
    },
    {
      "files": ["src/lib/discogs-request-throttle.ts"],
      "rules": {
        "unused-class-member": "off"
      }
    },
    {
      "files": ["**/*.po.tsx"],
      "rules": {
        "unused-class-member": "off"
      }
    }
  ]
}
