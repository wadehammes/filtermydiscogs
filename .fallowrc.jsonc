{
  "$schema": "./node_modules/fallow/schema.json",
  // Ad-hoc codebase intelligence for agents (CI dead-code gate stays on Knip — knip.json).
  "ignoreDependencies": [
    "@svgr/webpack",
    "identity-obj-proxy",
    "jest-fixed-jsdom",
    "jest-fetch-mock",
    "jest-location-mock",
    "typescript-langservice",
    "tslib"
  ],
  "ignoreDependencyOverrides": [
    { "package": "svgo", "source": "pnpm-workspace.yaml" },
    { "package": "picomatch", "source": "pnpm-workspace.yaml" },
    { "package": "postcss", "source": "pnpm-workspace.yaml" },
    { "package": "hono", "source": "pnpm-workspace.yaml" },
    { "package": "@hono/node-server", "source": "pnpm-workspace.yaml" },
    {
      "package": "@babel/plugin-transform-modules-systemjs",
      "source": "pnpm-workspace.yaml"
    }
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreExports": [
    { "file": "src/context/auth.context.tsx", "exports": ["*"] },
    { "file": "src/types/index.ts", "exports": ["*"] },
    { "file": "src/context/collection.context.tsx", "exports": ["*"] },
    { "file": "src/types/dashboard.types.ts", "exports": ["*"] },
    { "file": "src/utils/milestones.ts", "exports": ["*"] },
    { "file": "src/utils/styleEvolution.ts", "exports": ["*"] },
    { "file": "src/hooks/useCollectionCacheReady.hook.ts", "exports": ["*"] },
    { "file": "src/utils/collectionCacheSync.ts", "exports": ["*"] }
  ],
  // CI: scripts/fallow-audit-ci.sh (pnpm fallow:audit:ci) — exit 1 only when a worsened finding has effective_severity error.
  // Local pr-prep: pnpm fallow:audit — default gate new-only (introduced findings can fail).
  "audit": {
    "gate": "new-only",
    "worsened": "warn"
  },
  "rules": {
    "duplicate-export": "warn"
  },
  "ignorePatterns": ["public/theme-init.js", ".jest/**"],
  "health": {
    // Score and complexity focus on shipped code; specs/page objects stay reachable via the graph.
    "ignore": ["**/*.spec.ts", "**/*.spec.tsx", "**/*.po.tsx", "e2e/**"]
  },
  "entry": [
    ".jest/setupTests.ts",
    ".jest/setEnvVars.ts",
    "src/tests/mocks/mockCanvas.mock.ts",
    "src/tests/mocks/mockNextRouter.mock.ts",
    "src/lib/__mocks__/api-helpers.ts",
    "src/styles/stylelint-custom-properties.css",
    "src/styles/modules/base-ui-tooltip.module.css",
    "src/styles/modules/action-icon-hover.module.css",
    "src/styles/modules/action-indicator-dot.module.css",
    "src/styles/modules/badge.module.css",
    "src/styles/modules/bottom-drawer-chrome.module.css",
    "src/styles/modules/chevron-expand.module.css",
    "src/styles/modules/dashboard-chart.module.css",
    "src/styles/modules/dashboard-stack.module.css",
    "src/styles/modules/field-label.module.css",
    "src/styles/modules/inline-popover-menu.module.css",
    "src/styles/modules/menu-item-interaction.module.css",
    "src/styles/modules/modal-dialog.module.css",
    "src/styles/modules/patterns.module.css",
    "src/styles/modules/portal-enter-exit.module.css",
    "src/styles/modules/scratchpad-textarea.module.css",
    "src/styles/modules/workspace-fab-chrome.module.css"
  ],
  "overrides": [
    {
      "files": ["src/types/**"],
      "rules": {
        "unused-export": "off",
        "unused-type": "off"
      }
    },
    {
      "files": ["src/context/**"],
      "rules": {
        "unused-export": "off",
        "unused-type": "off",
        "unused-enum-member": "off"
      }
    },
    {
      "files": ["src/tests/factories/BaseFactory.ts"],
      "rules": {
        "unused-class-member": "off"
      }
    },
    {
      "files": [
        "src/components/ReleaseNotes/ReleaseNotesEditor.context.tsx",
        "src/atoms/view.atoms.ts",
        "src/components/FormDialog/**",
        "src/components/InlinePopoverMenu/**",
        "src/components/SegmentedControl/**"
      ],
      "rules": {
        "unused-export": "off",
        "unused-type": "off"
      }
    },
    {
      "files": [
        "src/hooks/queries/useAdminStatsQuery.ts",
        "src/hooks/usePersistUserPreferences.hook.ts"
      ],
      "rules": {
        "unused-type": "off"
      }
    },
    {
      "files": ["src/lib/discogs-request-throttle.ts"],
      "rules": {
        "unused-class-member": "off"
      }
    },
    {
      "files": ["**/*.po.tsx"],
      "rules": {
        "unused-class-member": "off"
      }
    }
  ]
}
