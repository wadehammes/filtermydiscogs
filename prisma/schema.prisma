// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

model User {
  discogs_user_id         Int      @id
  username                String
  /// [UserPreferences]
  preferences             Json     @default("{}")
  login_count             Int       @default(0)
  support_toast_dismissed Boolean   @default(false)
  support_toast_pending   Boolean   @default(false)
  last_seen_at            DateTime?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  crates      Crate[]
  user_tracks UserTrack[]

  @@map("users")
}

model UserTrack {
  user_id          Int
  track_key        String
  youtube_id       String?
  track_title      String
  track_position   String
  release_title    String?
  artist           String?
  instance_id      String
  play_count       Int      @default(0)
  listen_count     Int      @default(0)
  last_played_at   DateTime?
  last_listened_at DateTime?
  first_played_at  DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [discogs_user_id], onDelete: Cascade)

  @@id([user_id, track_key])
  @@index([user_id, last_played_at])
  @@index([user_id, last_listened_at])
  @@map("user_tracks")
}

model Crate {
  user_id    Int
  id         String    @default(uuid())
  name       String
  username   String?
  is_default Boolean   @default(false)
  private    Boolean   @default(true)
  packed_enabled Boolean @default(false)
  notes      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  user     User           @relation(fields: [user_id], references: [discogs_user_id], onDelete: Cascade)
  releases CrateRelease[]
  markers  CrateSetMarker[]

  @@id([user_id, id])
  @@index([user_id])
  @@index([user_id, is_default])
  @@index([id, private])
  @@map("crates")
}

model CrateRelease {
  user_id     Int
  crate_id    String
  instance_id String
  release_data Json
  added_at    DateTime @default(now())
  found_at    DateTime?
  sort_order  Int      @default(0)
  section_id  String?

  crate   Crate           @relation(fields: [user_id, crate_id], references: [user_id, id], onDelete: Cascade)
  section CrateSetMarker? @relation("CrateReleaseSection", fields: [user_id, crate_id, section_id], references: [user_id, crate_id, id], onDelete: SetNull)

  @@id([user_id, crate_id, instance_id])
  @@index([user_id, crate_id])
  @@index([user_id, instance_id])
  @@index([added_at])
  @@index([user_id, crate_id, added_at])
  @@index([user_id, crate_id, sort_order])
  @@map("crate_releases")
}

model CrateSetMarker {
  user_id    Int
  crate_id   String
  id         String   @default(uuid())
  label      String
  sort_order Int
  parent_id  String?
  accent_key String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  crate    Crate            @relation(fields: [user_id, crate_id], references: [user_id, id], onDelete: Cascade)
  parent   CrateSetMarker?  @relation("CrateSectionTree", fields: [user_id, crate_id, parent_id], references: [user_id, crate_id, id], onDelete: SetNull)
  children CrateSetMarker[] @relation("CrateSectionTree")
  releases CrateRelease[]   @relation("CrateReleaseSection")

  @@id([user_id, crate_id, id])
  @@index([user_id, crate_id, sort_order])
  @@map("crate_set_markers")
}

model ProductAnalyticsEvent {
  id         String   @id @default(uuid())
  event      String
  category   String
  action     String
  label      String
  value      String?
  page_path  String?
  user_id    Int?
  created_at DateTime @default(now())

  @@index([event, created_at])
  @@index([page_path, created_at])
  @@index([created_at])
  @@map("product_analytics_events")
}

model ProductAnalyticsDailyRollup {
  date           DateTime @db.Date
  dimension_type String
  dimension_key  String
  event_count    Int

  @@id([date, dimension_type, dimension_key])
  @@index([date])
  @@index([dimension_type, date])
  @@map("product_analytics_daily_rollups")
}

